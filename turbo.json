{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["INTERNAL_CONFIG", "NEXT_PUBLIC_APP_NAME", "NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_GA_ID", "DATABASE_URL", "BLOG_URL"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "start": {
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
